.sidebar

  .sidebar-top

    a.logo(href="/")

      img(src="/images/fotaza-logo-1.png" width="50px")

  if usuario

    .sidebar-menu

      a.sidebar-link(href="/usuario/home" class= isActive("/usuario/home") ? "active" : "")
        i.bi.bi-house

      a.sidebar-link(href="/usuario/colecciones" class=isActive("/usuario/colecciones") ? "active" : "")
        i.bi.bi-collection

      a.sidebar-link(href="/usuario/publicaciones/crear"  class=isActive("/usuario/publicaciones/crear") ? "active" : "")
        i.bi.bi-plus-square

      a.sidebar-link.position-relative(href="/usuario/notificaciones")
          i.bi.bi-bell

          if hayNotificacionesNoLeidas
              span.notification-dot

      a.sidebar-link(href="/usuario/chat" class=isActive("/usuario/chat") ? "active" : "")
        i.bi.bi-chat-dots

    .sidebar-bottom

      a.sidebar-link(href="#" class=isActive("/usuario/configuracion") ? "active" : "")
        i.bi.bi-gear

  else

    .sidebar-menu

      a.sidebar-link(href="/auth/login" title="Iniciar sesión")
        i.bi.bi-box-arrow-in-right

    .sidebar-bottom

      a.sidebar-link(href="/auth/register" title="Registrarse")
        i.bi.bi-person-plus
